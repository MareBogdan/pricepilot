# Copy to .env and fill in. NEVER commit .env (CLAUDE.md §0.5).

# --- Database (DECISIONS.md ADR-0014 — two databases, explicit split) -----
# DATABASE_URL is AUTHORITATIVE FOR COLLECTED DATA. It points at Neon (managed Postgres,
# Frankfurt region, pgvector enabled) — the daily scrape workflow, `make status`, `make
# migrate` and any manual inspection of real data all read this one. Use the UNPOOLED
# endpoint and the postgresql+psycopg:// scheme: the pooled endpoint does not support
# prepared statements, which Alembic needs. Get the real value from Neon's dashboard; this
# placeholder is not a working credential.
DATABASE_URL=postgresql+psycopg://neondb_owner:CHANGE_ME@ep-CHANGE-ME.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# TEST_DATABASE_URL is AUTHORITATIVE FOR TESTS AND OFFLINE DEVELOPMENT. It points at the
# local docker Postgres from docker-compose.yml — never Neon. `tests/conftest.py`
# mechanically overwrites the DATABASE_URL a running test process sees with this value
# before any test module is even collected, so a test run cannot reach Neon no matter what
# DATABASE_URL above holds — see tests/test_database_split.py, the self-test proving the
# guard trips. Leaving this unset (e.g. in CI) makes the suite run fully offline instead;
# that is intentional, not a fallback to worry about.
POSTGRES_USER=pricepilot
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=pricepilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
TEST_DATABASE_URL=postgresql+psycopg://pricepilot:change_me_locally@localhost:5433/pricepilot

# --- App ------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Mock store (services/mock_store) -------------------------------------
MOCK_STORE_PORT=8001
MOCK_STORE_URL=http://localhost:8001

# --- Scraping (CLAUDE.md §5) ----------------------------------------------
# Honest User-Agent with a contact address. Replace the email with yours.
SCRAPER_USER_AGENT=PricePilotBot/0.1 (+mailto:you@example.com; portfolio research project)
SCRAPER_MIN_DELAY_SECONDS=2.0
SCRAPER_MAX_DELAY_SECONDS=4.0
SCRAPER_DEFAULT_LIMIT=5

# --- LLM budget (CLAUDE.md §5) --------------------------------------------
# Hard cap enforced in src/pricepilot/llm/client.py. Exceeding it raises; never degrades silently.
LLM_BUDGET_USD=5.00
ANTHROPIC_API_KEY=
